# ==========================================
# ERP Enterprise - Root Git Ignore Rules
# ==========================================

# 1. Dependency Directories
node_modules/
frontend/node_modules/
vendor/
backend/vendor/

# 2. Build Outputs & Compilations
# Next.js Build Output
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
frontend/dist/
.turbo/
frontend/.turbo/

# Go Binary & Build Cache
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/*.exe
backend/erp-api-new.exe
backend/bin/
backend/dist/
backend/.gocache/
.gocache/

# 3. Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# (Keep .env.example tracked)
!.env.example
!backend/.env.example
!frontend/.env.example

# 4. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Database & Local Storage Volumes
postgres_data/
*.sql.gz
*.db
*.sqlite

# 6. IDE & OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editors & IDEs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
